# easysandbox — openbox (X11).  ->  sandbox-x11
#
# A self-contained, run-only graphical sandbox: Xvfb + a window manager, the
# easystream daemon (a11y/input/capture/H.264) and easyworker (which streams
# the screen). The screen is NOT served over VNC.
#
# The entrypoint is SHARED (common/entrypoint.sh); this file only installs the
# desktop and describes how to start it via the DESKTOP_* env vars.
ARG BASE_IMAGE=docker.io/library/debian:trixie-slim
FROM ${BASE_IMAGE}

ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=localhost,127.0.0.1,.svc.cluster.local,.svc,.nip.io,10.199.64.20 \
    DEBIAN_FRONTEND=noninteractive

# The X11 runtime + the AT-SPI2 accessibility stack (at-spi2-core is the bus
# launcher + registry; dbus carries the tree; libatk-adaptor is what a GTK app
# publishes its tree through) + the libxcb/libegl set a GUI app expects.
RUN set -eux; \
    echo "apt via ${HTTP_PROXY:-direct}"; \
    apt-get -o Acquire::Retries=10 update; \
    APT_OK=0; \
    for i in 1 2 3 4 5 6; do \
      apt-get -o Acquire::Retries=10 install -y --no-install-recommends \
        tini xvfb x11-utils xdotool xclip xsel git ca-certificates \
        openbox xterm zenity \
        fonts-dejavu fonts-noto-cjk \
        at-spi2-core dbus dbus-x11 libatk-adaptor \
        libxkbcommon0 libxkbcommon-x11-0 \
        libxcb-cursor0 libxcb-icccm4 libxcb-keysyms1 libxcb-image0 \
        libxcb-render-util0 libxcb-xkb1 libxcb-shape0 libxcb-render0 \
        libxcb-xfixes0 libegl1 libglib2.0-0t64 libdbus-1-3 libfontconfig1 \
        libpipewire-0.3-0 pulseaudio pulseaudio-utils \
        libasound2t64 libpulse0 libx11-6 libxcb1 libxrender1 libxtst6 \
        libxi6 libxcursor1 libxrandr2 libxcomposite1 libxdamage1 \
        libxfixes3 libxext6 libx264-164 libxcb-xtest0 libyuv0 libxcb-shm0 \
      && { APT_OK=1; break; } || { echo "apt retry $i"; sleep 3; }; \
    done; \
    [ "$APT_OK" = 1 ] || { echo "APT INSTALL FAILED" >&2; exit 1; }; \
    rm -rf /var/lib/apt/lists/*

# The guest binaries live in stage 2, not here.
#
# This file builds the BASE image for the flavor: the desktop stack from apt,
# plus the shared entrypoint. That is the expensive half - minutes of apt - and
# it changes only when a desktop package or the entrypoint does.
#
# easyworker and easystream are installed by Containerfile.worker on top of this
# image. They are separate GitHub releases on their own cadence, and neither is a
# build-time dependency of the desktop: dropping them in is one COPY. Keeping
# them out of here turns a new daemon release from a full apt rebuild into a cheap
# layer, which is the whole point of splitting the build.
ARG ENTRY_HASH=0
# The shared entrypoint is copied in; ENTRY_HASH makes this layer
# invalidate whenever common/entrypoint.sh changes (see build.sh).
RUN echo "entrypoint ${ENTRY_HASH}"
COPY --chmod=755 ./entrypoint.sh /usr/local/bin/entrypoint.sh

RUN mkdir -p /root/workspace

# openbox uses the DISTRO defaults (/etc/xdg/openbox/rc.xml + menu.xml); do NOT
# write a minimal rc.xml, it would replace the defaults and drop the mousebinds
# that make titlebar buttons and click-to-focus work.
ENV WORKER_PORT=48080 \
    WORKER_DB=/data/jobs.db \
    DISPLAY=:99 \
    SCREEN_GEOMETRY=1024x768x24 \
    DBUS_SESSION_BUS_ADDRESS=unix:path=/tmp/agent-dbus \
    NO_AT_BRIDGE=0 \
    AT_SPI_CLIENT=true \
    ACCESSIBILITY_ENABLED=1 \
    DESKTOP_KIND=x11 \
    DESKTOP_CMD="openbox" \
    DESKTOP_TERM="zenity --progress --text=easyworker --pulsate --no-cancel --width=420" \

EXPOSE 48080
ENTRYPOINT ["/usr/bin/tini", "-s", "/usr/local/bin/entrypoint.sh"]
