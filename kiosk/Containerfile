# easysandbox — kiosk (cage + chromium).  ->  sandbox-kiosk
#
# A locked-down browser kiosk: cage (the Wayland kiosk compositor) runs exactly
# ONE client, chromium, full-screen — with Chrome's own UI (tabs / omnibox)
# visible. There is NO desktop, NO window manager, NO launcher and NO terminal:
# nothing can spawn a second app.
#
# On top of cage's single-app guarantee this image adds defence in depth:
#   * every user-launchable app except chromium is removed (incl. terminals,
#     file managers, editors, package managers, downloaders, interpreters);
#   * a Chrome enterprise policy locks the browser (no DevTools, no downloads,
#     no settings/flags/extensions pages, no incognito, no password manager);
#   * the deployment runs with a read-only rootfs (see kiosk.yaml) so the guest
#     cannot modify the system.
#
# The guest is driven ONLY through the easystream daemon (est:// video + input,
# /a11y/* on HTTP) — there is no shell, no SSH, no VNC.
ARG BASE_IMAGE=docker.io/library/debian:trixie-slim
FROM ${BASE_IMAGE}

ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=localhost,127.0.0.1,.svc.cluster.local,.svc,.nip.io,10.199.64.20 \
    DEBIAN_FRONTEND=noninteractive

# cage + chromium + the a11y/portal stack + wlroots helpers.
# The deb822 .sources file silently dropped the `main` stanza under buildkit,
# so we use a plain sources.list (see easysandbox#N for the same workaround).
# Audio: PulseAudio, NOT PipeWire. In a container with no sound card PipeWire's
# null sink never runs (it needs a driver to push it), so it captures silence;
# PulseAudio's module-null-sink has its own timer clock and RUNS headlessly.
RUN set -eux; \
    rm -f /etc/apt/sources.list.d/debian.sources; \
    printf 'deb http://mirrors.aliyun.com/debian trixie main contrib non-free non-free-firmware\n' \
         'deb http://mirrors.aliyun.com/debian trixie-updates main contrib non-free non-free-firmware\n' \
         'deb http://mirrors.aliyun.com/debian-security trixie-security main contrib non-free non-free-firmware\n' \
         > /etc/apt/sources.list; \
    APT_OK=0; \
    for i in 1 2 3 4 5 6; do \
      apt-get -o Acquire::Retries=10 -o Acquire::http::Timeout=60 update \
      && (apt-get purge -y pipewire pipewire-bin pipewire-pulse 2>/dev/null || true) \
      && apt-get -o Acquire::Retries=10 -o Acquire::http::Timeout=60 install -y --no-install-recommends \
        tini cage chromium \
        at-spi2-core dbus dbus-x11 libatk-adaptor \
        pulseaudio pulseaudio-utils \
        xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk \
        wlr-randr \
        fonts-dejavu fonts-noto-cjk \
        libgbm1 libxkbcommon0 libnss3 libgtk-3-0t64 \
        libasound2t64 libpulse0 libx11-6 libxcb1 libxrender1 libxtst6 \
        libxi6 libxcursor1 libxrandr2 libxcomposite1 libxdamage1 \
        libxfixes3 libxext6 libx264-164 libxcb-xtest0 libyuv0 \
      && { APT_OK=1; break; } || { echo "apt retry $i"; sleep 3; }; \
    done; \
    [ "$APT_OK" = 1 ] || { echo "APT INSTALL FAILED" >&2; exit 1; }; \
    rm -rf /var/lib/apt/lists/*

# --- lock it down: remove every user-launchable app that isn't chromium -----
# Terminals (foot/xterm/...), file managers, editors, the browser-openers and
# the package managers / downloaders / interpreters. A user inside the kiosk
# has no way to reach any of them anyway (cage has no launcher, no terminal),
# but removing them makes the guarantee structural.
RUN set -eux; \
    for p in foot xterm gnome-terminal konsole tilix xfce4-terminal kitty alacritty \
             pcmanfm thunar nautilus nemo caja dolphin \
             gedit mousepad leafpad nano vim vi emacs ed joe mcedit \
             xdg-open x-www-browser www-browser sensible-browser \
             gio gvfs-open gnome-open exo-open zenity; do \
      rm -f "/usr/bin/$p" "/usr/local/bin/$p" "/bin/$p" 2>/dev/null || true; \
    done; \
    rm -f /usr/bin/python3 /usr/bin/python3.* /usr/bin/python \
          /usr/bin/perl /usr/bin/perl5* /usr/bin/ruby* \
          /usr/bin/node /usr/bin/nodejs /usr/bin/php* /usr/bin/lua* \
          /usr/bin/tclsh* /usr/bin/zsh /usr/bin/ksh /usr/bin/csh \
          /usr/bin/busybox /usr/bin/toybox 2>/dev/null || true; \
    rm -f /usr/bin/apt /usr/bin/apt-get /usr/bin/apt-cache /usr/bin/apt-config \
          /usr/bin/dpkg /usr/bin/dpkg-deb /usr/bin/dpkg-query /usr/bin/dpkg-split \
          /usr/bin/wget /usr/bin/curl /usr/bin/nc /usr/bin/ncat /usr/bin/netcat \
          /usr/bin/socat /usr/bin/telnet /usr/bin/ftp /usr/bin/ssh /usr/bin/scp \
          /usr/bin/git /usr/bin/openssl 2>/dev/null || true

# --- Chrome enterprise policy ----------------------------------------------
COPY --chmod=644 ./chrome-policy.json /etc/chromium/policies/managed/kiosk.json

# --- the guest binaries (fetched from releases by build.sh) -----------------
COPY --chmod=755 ./agent-worker /usr/local/bin/agent-worker
COPY --chmod=755 ./easystream   /usr/local/bin/easystream

# --- the kiosk entrypoint (this flavor does NOT use common/entrypoint.sh) ---
ARG ENTRY_HASH=0
RUN echo "entrypoint ${ENTRY_HASH}"
COPY --chmod=755 ./entrypoint.sh /usr/local/bin/entrypoint.sh

RUN mkdir -p /root/workspace

# Defaults; the deployment may override KIOSK_URL / SCREEN_GEOMETRY.
ENV WORKER_PORT=48080 \
    WORKER_DB=/data/jobs.db \
    EAZYSTREAM_PORT=48079 \
    EAZYSTREAM_HTTP_PORT=48078 \
    KIOSK_URL="about:blank" \
    SCREEN_GEOMETRY=1024x768 \
    DBUS_SESSION_BUS_ADDRESS=unix:path=/tmp/agent-dbus \
    XDG_RUNTIME_DIR=/tmp/xdg \
    XDG_CURRENT_DESKTOP=wlroots \
    NO_AT_BRIDGE=0 \
    AT_SPI_CLIENT=true \
    ACCESSIBILITY_ENABLED=1

EXPOSE 48078 48079 48080
ENTRYPOINT ["/usr/bin/tini", "-s", "/usr/local/bin/entrypoint.sh"]
