# easysandbox — GNOME on X11.  ->  sandbox-gnome-x11
#
# gnome-shell (the default desktop) on an X11 session: Xvfb + mutter's X11
# backend + gnome-session. GL goes through llvmpipe (software), which is enough
# at 1024x768.
ARG BASE_IMAGE=docker.io/library/debian:trixie-slim
FROM ${BASE_IMAGE}

ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=localhost,127.0.0.1,.svc.cluster.local,.svc,.nip.io,10.199.64.20 \
    DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    echo "apt via ${HTTP_PROXY:-direct}"; \
    apt-get -o Acquire::Retries=10 update; \
    APT_OK=0; \
    for i in 1 2 3 4 5 6; do \
      apt-get -o Acquire::Retries=10 install -y --no-install-recommends \
        tini xvfb x11-utils xdotool xclip xsel dbus-x11 \
        gnome-session gnome-session-bin gnome-shell mutter \
        gnome-settings-daemon gnome-terminal nautilus zenity \
        fonts-dejavu fonts-noto-cjk locales \
        at-spi2-core dbus libatk-adaptor \
        libgl1-mesa-dri libglx-mesa0 libegl-mesa0 \
        libxkbcommon0 libxkbcommon-x11-0 \
        libxcb-cursor0 libxcb-icccm4 libxcb-keysyms1 libxcb-image0 \
        libxcb-render-util0 libxcb-xkb1 libxcb-shape0 libxcb-render0 \
        libxcb-xfixes0 libegl1 libglib2.0-0t64 libdbus-1-3 libfontconfig1 \
        libgbm1 libnss3 libgtk-3-0t64 libgtk-4-1 libpango-1.0-0 libpangocairo-1.0-0 \
        libasound2t64 libpulse0 libx11-6 libxcb1 libxrender1 libxtst6 \
        libxi6 libxcursor1 libxrandr2 libxcomposite1 libxdamage1 \
        libxfixes3 libxext6 libx264-164 libxcb-xtest0 libyuv0 libxcb-shm0 \
      && { APT_OK=1; break; } || { echo "apt retry $i"; sleep 3; }; \
    done; \
    [ "$APT_OK" = 1 ] || { echo "APT INSTALL FAILED" >&2; exit 1; }; \
    rm -rf /var/lib/apt/lists/*

COPY --chmod=755 ./agent-worker /usr/local/bin/agent-worker
COPY --chmod=755 ./easystream   /usr/local/bin/easystream
ARG ENTRY_HASH=0
# The shared entrypoint is copied in; ENTRY_HASH makes this layer
# invalidate whenever common/entrypoint.sh changes (see build.sh).
RUN echo "entrypoint ${ENTRY_HASH}"
COPY --chmod=755 ./entrypoint.sh /usr/local/bin/entrypoint.sh

RUN mkdir -p /root/workspace
# gnome-shell needs a session mode; Debian's gnome-shell-common ships the modes/
# directory EMPTY, so write the standard `user` mode.
RUN mkdir -p /usr/share/gnome-shell/modes && \
    printf '%s\n' \
      '{' \
      '  "name": "GNOME",' \
      '  "sessionType": "x11",' \
      '  "isDefault": true' \
      '}' > /usr/share/gnome-shell/modes/user.json && \
    cat /usr/share/gnome-shell/modes/user.json

# gnome-session refuses to run without a login manager UNLESS the session is
# given explicitly; --session gnome-xorg picks mutter's X11 backend. A software
# GL stack is forced because there is no GPU.
ENV WORKER_PORT=48080 \
    WORKER_DB=/data/jobs.db \
    LANG=C.UTF-8 \
    DISPLAY=:99 \
    SCREEN_GEOMETRY=1024x768x24 \
    DBUS_SESSION_BUS_ADDRESS=unix:path=/tmp/agent-dbus \
    LIBGL_ALWAYS_SOFTWARE=1 \
    GALLIUM_DRIVER=llvmpipe \
    MUTTER_DEBUG_DUMMY_MODE_SPECS=1024x768 \
    NO_AT_BRIDGE=0 \
    AT_SPI_CLIENT=true \
    ACCESSIBILITY_ENABLED=1 \
    XDG_CURRENT_DESKTOP=GNOME \
    XDG_SESSION_DESKTOP=gnome-xorg \
    DESKTOP_KIND=x11 \
    DESKTOP_CMD="gnome-session --session gnome-xorg" \
    DESKTOP_TERM="gnome-terminal --title agent-worker"

EXPOSE 48080
ENTRYPOINT ["/usr/bin/tini", "-s", "/usr/local/bin/entrypoint.sh"]
